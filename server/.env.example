# OpenAI API key (required for embeddings + explanations)
OPENAI_API_KEY=sk-your-key-here

# PostgreSQL connection string (optional — app falls back to Google Books API without it)
DATABASE_URL=postgresql://user:password@localhost:5432/plotseeker

# Amazon Associates affiliate tag
AMAZON_AFFILIATE_TAG=YOUR_AFFILIATE_TAG

# Server port
PORT=5000
